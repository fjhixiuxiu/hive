{
  "name": "hive-ai",
  "version": "0.1.0",
  "description": "Command your AI coding fleet from your phone",
  "main": "src/index.js",
  "bin": {
    "hive": "src/cli.js",
    "hive-worker": "src/worker.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "ai",
    "claude",
    "tmux",
    "fleet",
    "telegram",
    "automation",
    "coding-agents"
  ],
  "author": "Nukul Bhasin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nukulb/hive.git"
  },
  "homepage": "https://github.com/nukulb/hive#readme",
  "dependencies": {
    "@deepgram/sdk": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@slack/bolt": "^4.6.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.66.0",
    "playwright": "^1.58.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "vitest": "^1.6.1"
  }
}
